{
  // Template: tools/setup/apply.mjs renders this file to wrangler.jsonc from
  // skeleton.config.json (re-run it with --board-only after the D1 id and the
  // keys are known). Edit the template, not the rendered file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{WORKER_NAME}}",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "{{CLOUDFLARE_ACCOUNT_ID}}",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The API, the root redirect and the bare page paths go to the Worker.
    "run_worker_first": ["/api/*", "/", "/board", "/feedback"],
  },
  "observability": { "enabled": true },
  "vars": {
    // Public values: the Turnstile site key is shown to every browser anyway.
    // Secrets (TURNSTILE_SECRET, SESSION_SECRET, OWNER_KEY, AGENT_KEYS) are set
    // with `npm run setup:secrets`.
    "TURNSTILE_SITE_KEY": "{{TURNSTILE_SITE_KEY}}",
    "PROJECT_NAME": "{{PROJECT_NAME}}",
    "ENVIRONMENT": "production",
  },
  "routes": [{ "pattern": "{{BOARD_HOST}}", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "{{D1_NAME}}", "database_id": "{{D1_ID}}" },
  ],
  // File storage is optional: tools/setup/apply.mjs drops the next line when
  // board.r2Bucket is empty (R2 needs a payment card even on the free plan). The
  // board then works without screenshots, attachments and feedback images.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "{{R2_BUCKET}}" }],
  "workers_dev": false,
}
